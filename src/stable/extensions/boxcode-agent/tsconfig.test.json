{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./out-test",
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "ES2022",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"],
		"typeRoots": ["./node_modules/@types"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/extension.ts"]
}
