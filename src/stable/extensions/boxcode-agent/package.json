{
  "name": "boxcode-agent",
  "displayName": "boxcode",
  "description": "Chat with boxcode, driven over its ACP stdio interface.",
  "version": "1.0.0",
  "publisher": "boxcode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.126.0"
  },
  "enabledApiProposals": [
    "chatParticipantAdditions",
    "defaultChatParticipant",
    "browser"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "scripts": {
    "compile": "gulp compile-extension:boxcode-agent",
    "watch": "gulp watch-extension:boxcode-agent",
    "test": "tsc -p . --outDir out-test && node --test out-test/*.test.js"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "boxcode.agent",
        "name": "boxcode",
        "fullName": "boxcode",
        "description": "Ask boxcode to read, write, and run things in this workspace.",
        "isDefault": true,
        "locations": [
          "panel"
        ],
        "modes": [
          "ask",
          "edit",
          "agent"
        ]
      }
    ],
    "commands": [
      {
        "command": "boxcode.rollback",
        "title": "boxcode: Undo Session's File Changes",
        "category": "boxcode"
      }
    ],
    "configuration": {
      "title": "boxcode",
      "properties": {
        "boxcode.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL for boxcode's OpenAI-compatible LLM endpoint (e.g. `https://api.deepseek.com`). Leave empty to be prompted on first use, or if `~/.boxcode/config.toml` already has one set up from using the `boxcode` CLI directly."
        },
        "boxcode.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model name to request from the configured endpoint (e.g. `deepseek-chat`)."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HolboxAI/boxcode-ide.git"
  }
}
