+/**
+ * boxcode-ide: the landing page (and, by extension, an active boxcode chat
+ * session) is meant to read as a clean, dedicated surface, not a full IDE
+ * with an empty sidebar/toolbar already showing -- the activity bar (file/
+ * search/git/debug/extensions icons) and the title bar's right-side icon
+ * cluster (editor-layout-split controls, the Integrated Browser toggle) are
+ * both meaningless before any project or session actually exists.
+ *
+ * A first version of this lived entirely inside `AgentSessionsWelcomePage`'s
+ * own `setEditorVisible()` override -- but submitting the first prompt calls
+ * `closeEditorAndMaximizeAuxiliaryBar()`, which *closes* the welcome editor
+ * to reveal the chat view (contributed to the auxiliary bar, not the editor
+ * area -- see `boxcode-agent/package.json`'s `"locations": ["panel"]`), so
+ * `setEditorVisible(false)` fired at exactly the moment the user started
+ * using the product, undoing the whole effect on first contact. Keying off
+ * `isAuxiliaryBarMaximized()` (already the real, guarded signal for "a
+ * boxcode chat session, not just a stray view, has taken over the window" --
+ * see patches/89's fix to `closeEditorAndMaximizeAuxiliaryBar`) as well as
+ * "the welcome page is the active editor" keeps the minimal treatment
+ * through that exact transition, and lets it end naturally the moment the
+ * user opens a real file (which un-maximizes the auxiliary bar) rather than
+ * needing separate logic to detect "the user is coding now."
+ */
+class BoxcodeMinimalChromeContribution extends Disposable implements IWorkbenchContribution {
+	static readonly ID = 'workbench.contrib.boxcodeMinimalChrome';
+
+	// Whether the activity bar was visible immediately before this
+	// contribution hid it -- restored on the way out instead of
+	// unconditionally forcing it back on, so a user who has set
+	// workbench.activityBar.location to "hidden" doesn't get it forced
+	// visible, and one running "top"/"bottom" doesn't get a duplicate grid
+	// activity bar alongside the title-bar activity actions.
+	private activityBarWasVisible = true;
+	private isMinimal = false;
+
+	constructor(
+		@IWorkbenchLayoutService private readonly layoutService: IWorkbenchLayoutService,
+		@IEditorService private readonly editorService: IEditorService,
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+	) {
+		super();
+
+		this._register(this.layoutService.onDidChangeAuxiliaryBarMaximized(() => this.update()));
+		this._register(this.editorService.onDidActiveEditorChange(() => this.update()));
+		this.update();
+	}
+
+	private update(): void {
+		const shouldBeMinimal = this.layoutService.isAuxiliaryBarMaximized()
+			|| this.editorService.activeEditor instanceof AgentSessionsWelcomeInput;
+
+		if (shouldBeMinimal === this.isMinimal) {
+			return;
+		}
+		this.isMinimal = shouldBeMinimal;
+
+		if (shouldBeMinimal) {
+			this.activityBarWasVisible = this.layoutService.isVisible(Parts.ACTIVITYBAR_PART, mainWindow);
+			this.layoutService.setPartHidden(true, Parts.ACTIVITYBAR_PART);
+		} else {
+			this.layoutService.setPartHidden(!this.activityBarWasVisible, Parts.ACTIVITYBAR_PART);
+		}
+
+		const container = this.layoutService.getContainer(mainWindow);
+		container.classList.toggle('boxcode-chrome-minimal', shouldBeMinimal);
+
+		// titlebarPart.ts renders layout-control actions, editor actions, and
+		// -- only when workbench.activityBar.location is "top"/"bottom" -- the
+		// global settings gear and Accounts menu, all as undifferentiated
+		// siblings in one shared toolbar container, with no per-item class or
+		// data attribute to target individually (confirmed by reading
+		// createActionToolBarMenus() and actionViewItemProvider() in
+		// titlebarPart.ts, and BaseActionViewItem's render() in
+		// actionViewItems.ts). Rather than hide someone's settings/accounts
+		// menu along with the layout controls, only apply the CSS class (see
+		// agentSessionsWelcome.css) that blanket-hides that container when the
+		// activity bar is NOT rendered in the title bar at all -- the default
+		// placement, and the only one this can hide safely.
+		const activityBarLocation = this.configurationService.getValue<string>(LayoutSettings.ACTIVITY_BAR_LOCATION);
+		const safeToHideTitleBarCluster = activityBarLocation !== 'top' && activityBarLocation !== 'bottom';
+		container.classList.toggle('boxcode-titlebar-minimal', shouldBeMinimal && safeToHideTitleBarCluster);
+	}
+}
+
 // Register contributions
 registerWorkbenchContribution2(AgentSessionsWelcomeEditorResolverContribution.ID, AgentSessionsWelcomeEditorResolverContribution, WorkbenchPhase.BlockStartup);
+registerWorkbenchContribution2(BoxcodeMinimalChromeContribution.ID, BoxcodeMinimalChromeContribution, WorkbenchPhase.AfterRestored);
 registerWorkbenchContribution2(AgentSessionsWelcomeRunnerContribution.ID, AgentSessionsWelcomeRunnerContribution, WorkbenchPhase.AfterRestored);

