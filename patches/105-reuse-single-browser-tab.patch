 registerWorkbenchContribution2(LocalhostLinkOpenerContribution.ID, LocalhostLinkOpenerContribution, WorkbenchPhase.BlockStartup);
 
+function isIdleBrowserHref(href: string | undefined): boolean {
+	return !href || href === 'about:blank';
+}
+
+function localhostOriginsMatch(left: string, right: string): boolean {
+	try {
+		const a = new URL(canonicalizeLoopbackHref(left));
+		const b = new URL(canonicalizeLoopbackHref(right));
+		return a.protocol === b.protocol && a.host === b.host;
+	} catch {
+		return false;
+	}
+}
+
+function canonicalizeLoopbackHref(href: string): string {
+	const parsed = new URL(href);
+	if (parsed.hostname === '127.0.0.1' || parsed.hostname === '0.0.0.0' || parsed.hostname.toLowerCase() === 'localhost') {
+		parsed.hostname = 'localhost';
+	}
+	const path = parsed.pathname === '/' ? '' : parsed.pathname.replace(/\/+$/, '');
+	return `${parsed.protocol}//${parsed.host}${path}${parsed.search}${parsed.hash}`;
+}
+
+function editorMatchesReuseFilter(editorUrl: string | undefined, reuseUrlFilter: string): boolean {
+	if (isIdleBrowserHref(editorUrl)) {
+		return false;
+	}
+	const filterUri = URI.parse(reuseUrlFilter);
+	const editorUri = URI.parse(editorUrl!);
+	// URIs default to putting "file" scheme. Check that the scheme is really in the filter.
+	if (filterUri.scheme && reuseUrlFilter.startsWith(`${filterUri.scheme}:`) && filterUri.scheme !== editorUri.scheme) {
+		return false;
+	}
+	if (filterUri.authority && !match(filterUri.authority, editorUri.authority)) {
+		return false;
+	}
+	// An origin-only filter (`http://localhost:5173`) parses with path `/`.
+	// That must still match `/menu`, otherwise the agent and the localhost
+	// link opener stack a second tab for the same preview.
+	if (filterUri.path && filterUri.path !== '/' && !match(filterUri.path, editorUri.path)) {
+		return false;
+	}
+	if (filterUri.query) {
+		const filterParams = new URLSearchParams(filterUri.query);
+		const editorParams = new URLSearchParams(editorUri.query);
+		if (![...filterParams].every(([key, value]) => match(value, editorParams.get(key) ?? ''))) {
+			return false;
+		}
+	}
+	return true;
+}
