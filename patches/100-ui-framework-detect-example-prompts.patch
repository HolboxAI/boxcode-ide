 	/**
+	 * boxcode-ide: best-effort framework detection for the open-workspace
+	 * example prompts, so the seeded chips name what's actually in the folder
+	 * instead of a generic set for every project. Reads package.json at the
+	 * workspace root only - deliberately checks meta-frameworks (next, svelte,
+	 * vue, angular) before the bare build-tool/library signals (vite, react),
+	 * since e.g. a SvelteKit or Vue+Vite project also lists `vite` as a
+	 * dependency and would otherwise be misclassified as generic Vite. Never
+	 * throws - any failure (no folder, missing/invalid package.json, no match)
+	 * returns undefined and the caller falls back to OPEN_WORKSPACE_EXAMPLE_PROMPTS.
+	 */
+	private async detectFramework(): Promise<WelcomeFrameworkId | undefined> {
+		const root = this.workspaceContextService.getWorkspace().folders[0]?.uri;
+		if (!root) {
+			return undefined;
+		}
+
+		try {
+			const content = await this.fileService.readFile(URI.joinPath(root, 'package.json'));
+			const pkg = JSON.parse(content.value.toString());
+			const deps: Record<string, unknown> = { ...pkg?.dependencies, ...pkg?.devDependencies };
+
+			if ('next' in deps) {
+				return 'next';
+			}
+			if ('@sveltejs/kit' in deps || 'svelte' in deps) {
+				return 'svelte';
+			}
+			if ('vue' in deps) {
+				return 'vue';
+			}
+			if ('@angular/core' in deps) {
+				return 'angular';
+			}
+			if ('vite' in deps) {
+				return 'vite';
+			}
+			if ('react' in deps) {
+				return 'react';
+			}
+			if ('express' in deps || 'fastify' in deps || 'koa' in deps) {
+				return 'node';
+			}
+		} catch {
+			// No package.json, invalid JSON, or unreadable - fall back to the generic set.
+		}
+
+		return undefined;
+	}
+
+	/**
 	 * boxcode-ide: render the example prompt chips under the chat input.
 	 *
 	 * Clicking a chip fills the input and focuses it - it deliberately does not
 	 * submit, so the prompt stays editable and the user can add their own detail
 	 * before sending. Same mechanism `applyPrefillData` already uses.
 	 */
-	private buildExamplePrompts(container: HTMLElement): void {
-		const prompts = this._isEmptyWorkspace ? EMPTY_WORKSPACE_EXAMPLE_PROMPTS : OPEN_WORKSPACE_EXAMPLE_PROMPTS;
+	private async buildExamplePrompts(container: HTMLElement): Promise<void> {
+		let prompts: IWelcomeExamplePrompt[];
+		if (this._isEmptyWorkspace) {
+			prompts = EMPTY_WORKSPACE_EXAMPLE_PROMPTS;
+		} else {
+			const framework = await this.detectFramework();
+			prompts = framework ? FRAMEWORK_EXAMPLE_PROMPTS[framework] : OPEN_WORKSPACE_EXAMPLE_PROMPTS;
+		}
 		if (prompts.length === 0) {
 			return;
 		}
